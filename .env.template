# Which stack Dewey runs on. Always set it:
#   azure      Azure OpenAI + Azure AI Search + Azure Blob Storage
#   anthropic  Claude + Postgres/pgvector; hosted Voyage AI embeddings by default
#   open       open-weight chat model on your own server (e.g. Ollama) + Postgres/pgvector
#              + open-weight embeddings/reranking on this machine. No paid services.
# If this line is missing, Dewey runs "azure", the setup it was first built on. The setup
# wizard (python install.py) always writes the line. On its first run the wizard's list
# starts at "anthropic", marked "(suggested)": that is only what Enter picks there, not
# the default and not a recommendation (docs/STACKS.md compares the setups).
DEWEY_STACK="azure"

# Newsroom settings used in Dewey's prompts. When unset, they default to the
# original Philadelphia Inquirer deployment ("The Philadelphia Inquirer",
# "January 2, 1978", "the Greater Philadelphia Region").
# Set DEFAULT_REGION="" for a national outlet (no regional assumption).
# NEWSROOM_NAME="Your Newsroom"
# ARCHIVE_START_DATE="January 1, 2015"
# DEFAULT_REGION=""


# ---------------------------------------------------------------------------
# DEWEY_STACK="anthropic"
# ---------------------------------------------------------------------------

# Claude (Anthropic API). Create a key in the Claude Console (platform.claude.com).
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Or sign in with Anthropic's ant tool (ant auth login) instead of a key: then delete
# the ANTHROPIC_API_KEY line; do not leave it blank. docs/STACKS.md, "Signing in
# without an API key". ANTHROPIC_PROFILE="NAME" picks a named sign-in.
# Optional overrides (defaults shown)
# ANTHROPIC_MODEL="claude-opus-5-5"
# ANTHROPIC_METADATA_EFFORT="low"     # search-planning step
# ANTHROPIC_ANSWER_EFFORT="medium"    # cited answer

# ---------------------------------------------------------------------------
# Postgres stacks (DEWEY_STACK="anthropic" or "open")
# ---------------------------------------------------------------------------

# Postgres with the pgvector extension, 0.8 or newer. On an older one, date and byline
# searches can miss stories (docs/STACKS.md, "Upgrade pgvector").
DATABASE_URL="postgresql://user:password@localhost:5432/dewey"

# Where embeddings and reranking run:
#   voyage  hosted Voyage AI API (needs VOYAGE_API_KEY) - default for "anthropic"
#   local   open-weight models on this machine, no key  - default for "open"
#           (needs: pip install -r requirements-local.txt)
#   none    (RERANK_PROVIDER only) skip reranking
# EMBEDDING_PROVIDER="voyage"
# RERANK_PROVIDER="voyage"

# Model overrides (defaults shown). EMBED_MODEL and EMBED_DIM are fixed once a
# database is indexed; Dewey refuses to query an index built with other values.
# EMBED_MODEL="voyage-4"                    # local default (and only choice): voyage-4-nano
# EMBED_DIM="1024"
# RERANK_MODEL="rerank-3"                   # local default: BAAI/bge-reranker-v2-m3

# Local models only: the Hugging Face commit to load. Unset, Dewey keeps the
# version it first downloaded and never updates it on its own (voyage-4-nano's
# repo includes code that runs when it loads). Set a commit hash you reviewed
# to choose the version yourself.
# EMBED_MODEL_REVISION=""
# RERANK_MODEL_REVISION=""

# Voyage AI key, only needed when a provider above is "voyage".
# Model API key from MongoDB Atlas > AI Model APIs.
VOYAGE_API_KEY="your-voyage-api-key"


# ---------------------------------------------------------------------------
# DEWEY_STACK="open"
# ---------------------------------------------------------------------------

# Any OpenAI-compatible chat server. Default is a local Ollama install.
# Choosing a model and server (Ollama, vLLM or hosted OpenRouter): docs/MODELS.md
# OPEN_LLM_BASE_URL="http://localhost:11434/v1"
#   vLLM:        "http://localhost:8000/v1"
#   OpenRouter:  "https://openrouter.ai/api/v1"  (hosted: questions and article
#                excerpts leave your network)
# Model name as your server knows it, e.g. "qwen3:8b" or "gpt-oss:20b" in Ollama.
# For OpenRouter, copy the model id from openrouter.ai/models (pick one that
# supports structured outputs).
OPEN_LLM_MODEL=""
# Only if your server requires a key (local Ollama doesn't). Required for OpenRouter.
# OPEN_LLM_API_KEY=""

# OpenRouter only (ignored, with a startup warning, for other servers, including
# your own proxy in front of OpenRouter): privacy routing sent with every request.
#   strict    only providers that don't collect your data, and only Zero Data
#             Retention endpoints (data_collection=deny, zdr=true)   [default]
#             For strict zero retention, also choose "ZDR only" in your OpenRouter
#             privacy settings; otherwise "Safety Retention" endpoints (which may
#             keep prompts to prevent abuse) are still allowed.
#   standard  only providers that don't collect your data (data_collection=deny)
#   off       no preferences; your OpenRouter account settings decide
# OpenRouter still stores request metadata (token counts, latency) at every level.
# If no endpoint meets these (or supports structured outputs), Dewey stops with
# an error that explains what to change.
# OPENROUTER_PRIVACY="strict"


# ---------------------------------------------------------------------------
# DEWEY_STACK="azure"
# ---------------------------------------------------------------------------

# Azure OpenAI Configuration
# Required for embedding generation and AI capabilities
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
EMBEDDING_DEPLOYMENT_NAME="your-embedding-deployment-name"
EMBEDDING_MODEL_NAME="text-embedding-3-large"
CHATGPT_DEPLOYMENT_NAME="your-chatgpt-deployment-name"
CHATGPT_MODEL_NAME="gpt-5"


# Azure AI Search Configuration  
# Required for document indexing and search capabilities
AZURE_SEARCH_ENDPOINT="https://your-search-service.search.windows.net"
AZURE_SEARCH_API_KEY="your-azure-search-api-key"
AZURE_SEARCH_INDEX_NAME="your-search-index-name"

# Azure Blob Storage Configuration
# Required for document storage and indexer processing
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=your-storage-account;AccountKey=your-storage-key;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="documents"

# ---------------------------------------------------------------------------
# MCP server: how agents and chat apps reach Dewey (docs/MCP.md)
# ---------------------------------------------------------------------------

# Bearer token for the shared HTTP server (python app/mcp_server.py --http) and
# for Docker Compose, where it is required. At least 32 characters, e.g. the
# output of:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Anyone who has it can search the whole archive and, through ask_archive, spend
# your model budget. Not needed for stdio, where the agent starts the server itself.
# DEWEY_MCP_TOKEN=""

# ---------------------------------------------------------------------------
# Demo chat page (python app/main.py; see docs/DEPLOYMENT.md)
# ---------------------------------------------------------------------------

# The demo page has no login. It listens on 127.0.0.1 (this computer only) and
# refuses other addresses. Port (default: the first free one from 7860):
# GRADIO_SERVER_PORT="7860"
# Only if a proxy in front of the demo makes people sign in (single sign-on) and
# nothing else can reach its port; this allows GRADIO_SERVER_NAME="0.0.0.0".
# DEWEY_DEMO_BEHIND_AUTH_PROXY="false"
# Questions answered at the same time (default 4).
# DEWEY_CONCURRENCY="4"

# Docker Compose: the password for its bundled Postgres (the "db" service).
# Letters and digits only (it goes into a URL), e.g. the output of:
# openssl rand -hex 24
# The setup wizard (install.py) also writes this line, when there is none, with
# the password it makes for the dewey-db container it helps you start. That is
# a separate database. The wizard never changes a line that is already here.
# POSTGRES_PASSWORD=""
