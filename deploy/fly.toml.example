# Fly.io configuration for Dewey. Copy to the repository root as fly.toml and
# change `app` and `primary_region`. Walkthrough: docs/DEPLOYMENT.md ("Fly.io").
# Keys are from Fly's configuration reference:
# https://github.com/superfly/docs/blob/main/reference/configuration.mdx
#
# Secrets (API keys, DATABASE_URL, DEWEY_USERS) do not go in this file; set them
# with `fly secrets set NAME=value`. Fly injects them as environment variables.

app = "your-dewey-app"      # must be unique on Fly.io
primary_region = "ord"      # three-letter Fly region code; put it near your database

# fly deploy builds ./Dockerfile by default.
[build.args]
  INSTALL_LOCAL_MODELS = "false"   # "true" adds local embedding/reranking models (needs more memory)

# Non-secret settings.
[env]
  DEWEY_STACK = "anthropic"
  DEWEY_CONCURRENCY = "4"
  # NEWSROOM_NAME = "Your Newsroom"

[http_service]
  internal_port = 7860           # the Dockerfile sets GRADIO_SERVER_PORT=7860
  force_https = true
  # "stop" saves money while nobody is using Dewey, at the cost of a slower
  # first request and everyone being logged out (logins live in memory).
  # Use "off" to keep it running.
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

# "/" returns 200 (the login page) once Dewey is up.
[[http_service.checks]]
  grace_period = "60s"
  interval = "30s"
  method = "GET"
  timeout = "5s"
  path = "/"

[[vm]]
  memory = "1gb"   # a guess for the anthropic/azure stacks: raise it if Dewey runs out of memory;
                   # local models need more
