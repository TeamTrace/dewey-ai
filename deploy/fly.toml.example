# Fly.io configuration for Dewey's MCP server. Copy to the repository root as
# fly.toml and change `app` and `primary_region`. Walkthrough: docs/DEPLOYMENT.md
# ("Fly.io"). Keys are from Fly's configuration reference:
# https://github.com/superfly/docs/blob/main/reference/configuration.mdx
#
# Secrets (API keys, DATABASE_URL, DEWEY_MCP_TOKEN) do not go in this file; set
# them with `fly secrets set NAME=value`. Fly injects them as environment variables.
#
# The image's default command (see Dockerfile) runs the MCP server on port 8765.
# The demo chat page has no login and is not meant to run here.

app = "your-dewey-app"      # must be unique on Fly.io
primary_region = "ord"      # three-letter Fly region code; put it near your database

# fly deploy builds ./Dockerfile by default.
[build.args]
  INSTALL_LOCAL_MODELS = "false"   # "true" adds local embedding/reranking models (needs more memory)

# Non-secret settings.
[env]
  DEWEY_STACK = "anthropic"
  # Required: the server won't start without it. Use the same name as the .env you index with.
  NEWSROOM_NAME = "Your Newsroom"

[http_service]
  internal_port = 8765           # the Dockerfile's command listens on 8765
  force_https = true
  # "stop" saves money while nobody is using Dewey, at the cost of a slower
  # first request. MCP sessions live in the server's memory, so a stop ends
  # them and clients have to reconnect. Use "off" to keep it running.
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

# The MCP endpoint answers 401 without the token and Fly's HTTP checks expect a
# 2xx, so check that the port accepts connections instead.
[checks]
  [checks.mcp_port]
    type = "tcp"
    port = 8765
    grace_period = "60s"
    interval = "30s"
    timeout = "5s"

[[vm]]
  memory = "1gb"   # a guess for the anthropic/azure stacks: raise it if Dewey runs out of memory;
                   # local models need more
