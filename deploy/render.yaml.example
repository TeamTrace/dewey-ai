# Render Blueprint for Dewey. Copy to the repository root as render.yaml.
# Walkthrough: docs/DEPLOYMENT.md ("Render"). Keys follow Render's own
# Blueprint guidance: https://github.com/render-oss/skills (skills/render-blueprints).
#
# The database is NOT created here: we could not confirm from a Render-owned
# source that Render Postgres offers pgvector, so DATABASE_URL points at an
# external Postgres with pgvector (Neon, Supabase, Fly MPG, ...).
#
# Secrets are declared with `sync: false`: Render asks for their values when the
# Blueprint is first created, and they are never stored in git. Later changes
# (e.g. new accounts in DEWEY_USERS) are made in the Dashboard.

services:
  - type: web
    name: dewey
    runtime: docker            # builds ./Dockerfile
    plan: starter              # plan ID from Render's examples; check current plans. Free
                               # instances spin down when idle (cold starts, logins lost).
    healthCheckPath: /         # returns 200 (the login page) once Dewey is up
    envVars:
      # Render sends traffic to the port in its PORT variable (default often
      # 10000; see the service's Settings). The Docker image listens on
      # GRADIO_SERVER_PORT, so the two must match.
      - key: GRADIO_SERVER_PORT
        value: "10000"
      - key: DEWEY_STACK
        value: anthropic
      - key: DEWEY_CONCURRENCY
        value: "4"
      # --- secrets: values are entered in the Dashboard ---
      - key: DATABASE_URL        # external Postgres with pgvector; use a TLS (sslmode=require) URL
        sync: false
      - key: ANTHROPIC_API_KEY
        sync: false
      - key: VOYAGE_API_KEY      # not needed if EMBEDDING_PROVIDER/RERANK_PROVIDER are local/none
        sync: false
      - key: DEWEY_USERS         # login accounts: users.txt lines joined with commas
        sync: false
