  <item rdf:about="https://rdf.example.jp/en/2024/01/15/harbor.html">
    <title>Harbor cleanup &amp; what comes next</title>
    <link>https://rdf.example.jp/en/2024/01/15/harbor.html</link>
    <description>Volunteers removed two tons of debris.</description>
    <content:encoded><![CDATA[<p>Volunteers removed two tons of debris from the harbor on Sunday.</p><p>The city will add bins.</p>]]></content:encoded>
    <dc:creator>Aiko Tanaka</dc:creator>
    <dc:date>2024-01-15T10:00:00+09:00</dc:date>
  </item>
